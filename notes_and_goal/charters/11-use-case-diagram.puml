@startuml Catodo 用例图
skinparam backgroundColor #FEFEFE
skinparam usecase {
    BackgroundColor #E8F0FE
    BorderColor #3366CC
    FontColor #1A1A2E
}
skinparam actor {
    BackgroundColor #FFE0B2
    BorderColor #E65100
    FontColor #1A1A2E
}
skinparam rectangle {
    BackgroundColor #F8F9FA
    BorderColor #909090
    FontColor #2C3E50
    RoundCorner 10
}
left to right direction
' =================== Actors ===================
actor "用户" as User
actor "AI 大模型" as LLM
actor "WebDAV 服务器" as WebDAV
actor "通知系统" as Notif

' =================== Task Management ===================
rectangle "任务管理" as Tasks {
    usecase (UC1) as "创建任务\ncreate_task"
    usecase (UC2) as "编辑任务\nupdate_task"
    usecase (UC3) as "完成任务\ncomplete_task"
    usecase (UC4) as "撤销完成\nuncomplete_task"
    usecase (UC5) as "删除任务\ndelete_task"
    usecase (UC6) as "分解任务\ndecompose_task"
    usecase (UC7) as "标签管理\nadd/remove_tag"
    usecase (UC8) as "优先级\nset_priority"
    usecase (UC9) as "分组管理\nset_group"
    usecase (UC10) as "提醒管理\nadd/remove/clear"
    usecase (UC11) as "重复规则\nset/clear_repeat"
}

' =================== View ===================
rectangle "任务查看" as View {
    usecase (UC12) as "待办列表\n筛选/分段"
    usecase (UC13) as "艾森豪威尔\n四象限矩阵"
    usecase (UC14) as "按天视图\nfocusToday/hideOverdue"
}

' =================== AI ===================
rectangle "AI 功能" as AI {
    usecase (UC16) as "AI 对话\n意图识别+执行"
    usecase (UC17) as "NLP 智能解析\ntask_form 输入预览"
    usecase (UC18) as "情绪支持\n逾期爱心按钮"
    usecase (UC19) as "时间优化\nSchedulingOptimizer"
    usecase (UC20) as "查询任务\nquery_tasks"
    usecase (UC21) as "批量操作\nbulk_update"
}

' =================== Data ===================
rectangle "数据管理" as Data {
    usecase (UC22) as "导入 .ics"
    usecase (UC23) as "导出 .ics"
    usecase (UC24) as "导入 .catodo"
    usecase (UC25) as "导出 .catodo\n含/不含敏感字段"
    usecase (UC26) as "WebDAV 同步\n三种冲突策略"
}

' =================== Settings ===================
rectangle "设置" as Settings {
    usecase (UC27) as "AI 提供商\n7预设+自定义"
    usecase (UC28) as "WebDAV 服务器\nURL+认证"
    usecase (UC29) as "主题模式\nlight/dark/system"
}

' =================== Links ===================
User --> Tasks
User --> View
User --> AI
User --> Data
User --> Settings

' Secondary actors
UC16 --> LLM
UC17 --> LLM
UC19 --> LLM
UC20 --> LLM
UC21 --> LLM

UC26 --> WebDAV

' Notification triggers
UC3 --> Notif
UC5 --> Notif
UC10 --> Notif
UC11 --> Notif

@enduml
